<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Debug build (unsigned, then ad-hoc): the same as DatabaseClient.entitlements without keychain-access-groups (macOS
     does not open an ad-hoc signed app with that entitlement). The group comes from OA_DB_GROUP: in debug
     47QC6LXXDZ.com.openasy.db.dev. Update this file when DatabaseClient.entitlements changes (project.yml, entitlements). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(OA_DB_GROUP)</string>
	</array>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
